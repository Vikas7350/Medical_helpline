# Multilingual AI Medical Helpline Configuration
# Environment: development | production | test
ENVIRONMENT=development
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database
# Default: Local SQLite database
DATABASE_URL=sqlite:///./helpline.db
# PostgreSQL Example: postgresql+psycopg2://user:password@localhost:5432/helpline_db

# Security & Admin Authentication
# Change this secret key in production!
ADMIN_API_KEY=dev-hackathon-admin-key-2026
ADMIN_SECRET_TOKEN=dev-secret-token-change-in-prod

# Telephony Provider (Exotel / Generic IVR)
# Keep empty or mock for offline local testing
TELEPHONY_PROVIDER=mock
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_VIRTUAL_NUMBER=+918000000000
TELEPHONY_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Exotel Voicebot Bidirectional Audio Streaming Settings
# Sample rate for Voicebot streaming: 8000 (standard 8kHz PSTN default), 16000 (16kHz), or 24000
EXOTEL_STREAM_SAMPLE_RATE=8000
# Optional public WSS URL for Exotel Voicebot Applet (e.g. wss://helpline.yourdomain.com/api/v1/telephony/stream)
# If left blank, dynamically inferred from incoming request host
EXOTEL_STREAM_BASE_URL=
# Audio chunk size in bytes (must be multiple of 320, minimum 3200 bytes for 100ms window)
EXOTEL_STREAM_CHUNK_SIZE=3200
# Require Basic Auth on WebSocket stream (false allows Exotel IP whitelisting mode; true enforces Basic Auth)
EXOTEL_STREAM_REQUIRE_AUTH=false

# AI / Speech Services Configuration
# STT Providers: mock | speech_recognition | deepgram
# TTS Providers: edge_tts (Recommended: native Hindi, Marathi, Indian English, 100% free) | openai | deepgram | mock
# LLM Providers: mock | grok | xai | openai | gemini
STT_PROVIDER=mock
TTS_PROVIDER=edge_tts
LLM_PROVIDER=mock


# External AI Provider API Keys (Optional - only needed if providers != mock)
# xAI Grok API key for LLM medical guidance (LLM_PROVIDER=grok)
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# Privacy & Data Retention
# Number of days to retain anonymous records before automated cleanup
DATA_RETENTION_DAYS=90
# Maximum call duration in seconds before automatic timeout (e.g. 480 = 8 mins)
MAX_CALL_DURATION_SECONDS=480
# Inactivity turn timeout in seconds
TURN_TIMEOUT_SECONDS=30
